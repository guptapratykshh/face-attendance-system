# Copy to .env and adjust. All keys are prefixed FRS_.

# facenet | arcface | facenet-finetuned
FRS_ENCODER=facenet

# Optional fine-tuned FaceNet checkpoint (set automatically if evaluation.json records one)
# FRS_FACENET_CHECKPOINT=checkpoints/facenet_arcface.pt

# auto | mps | cpu | cuda
FRS_DEVICE=auto

# Cosine thresholds; overwritten at API startup from reports/evaluation.json at FAR=1e-3
FRS_VERIFY_THRESHOLD=0.5
FRS_IDENTIFY_THRESHOLD=0.5
FRS_TARGET_FAR=0.001

# Must be at least 32 bytes and not a placeholder. API will refuse to boot otherwise.
FRS_SECRET_KEY=local-dev-secret-key-at-least-32-chars!!
FRS_ACCESS_TOKEN_EXPIRE_MINUTES=720
FRS_ADMIN_PASSWORD=admin1234
FRS_ALLOW_PUBLIC_REGISTER=true
FRS_REQUIRE_LIVENESS=true
FRS_RATE_LIMIT=true
FRS_TZ=Asia/Kolkata
FRS_WORK_START=09:00
FRS_WORK_END=18:00
FRS_LATE_GRACE_MINUTES=15
# Must be a JSON array (list settings are JSON-decoded)
FRS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# SQLite for local unit tests / light dev. Production and Compose use PostGIS.
# FRS_DATABASE_URL=sqlite:///frs.db
# PostGIS (docker compose postgres service):
# FRS_DATABASE_URL=postgresql+psycopg://frs:frs@127.0.0.1:5432/frs

# LLM Assist (OpenAI-compatible). Required for POST /assist/chat.
# FRS_LLM_API_KEY=
# FRS_LLM_BASE_URL=https://api.openai.com/v1
# FRS_LLM_MODEL=gpt-4o-mini
# FRS_EMBED_MODEL=text-embedding-3-small
